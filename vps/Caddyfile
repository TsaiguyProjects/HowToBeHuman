# Caddy reverse proxy for VPS-2 deployment (MediaWiki).
# All traffic hits Caddy (:80/:443 with automatic Let's Encrypt),
# then forwards to the MediaWiki container.
# Set DOMAIN in .env (e.g. example.com). www redirect is optional — uncomment if needed.

{$DOMAIN} {
	reverse_proxy wiki:80
}

# Local dev fallback so http://localhost:80 works even when DOMAIN is a
# real domain (or localhost, which Caddy would otherwise serve on :443 only).
:80 {
	reverse_proxy wiki:80
}

# Uncomment to also serve www:
# www.{$DOMAIN} {
# 	redir https://{$DOMAIN}{uri} permanent
# }
