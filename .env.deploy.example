# Deployment variables for `make deploy`, `make logs`, `make status`.
# Copy to .env.deploy and fill in your values. Never commit .env.deploy.
#
# Format: KEY=value  (Makefile syntax — no quotes, no 'export' keyword)

# Required
VPS_HOST=your-vps.example.net
# Optional: public hostname for HTTPS (defaults to VPS_HOST)
DOMAIN=your-domain.example.net
VPS_USER=deploy

# Optional (defaults shown)
VPS_APP_DIR=/opt/how-to-be-human
CONTENT_DIR=/srv/how-to-be-human/content
VPS_SSH_PRIVATE_KEY_FILE=/Users/you/.ssh/how-to-be-human-deploy<|end|><|start|>assist to=write<|channel|>analysis <|constrain|>xml<|message|><rfl:parameter name="path">
