{
    on_demand_tls {
        ask http://backend:8080/api/caddy-ask
    }
}

(common) {
    reverse_proxy frontend:80

    # Security headers (Caddy adds some by default; keep consistent with nginx)
    header {
        X-Frame-Options "SAMEORIGIN"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
    }

    # Enable compression
    encode gzip
}

# Primary site: uses automatic HTTPS (Let's Encrypt for public domains,
# internal CA for localhost/IP-only deployments).
{$DOMAIN:localhost} {
    import common
}

# Fallback for any other host (e.g. accessing by IP when DOMAIN is a hostname):
# issue an internal (self-signed) certificate on demand instead of failing.
:443 {
    tls internal {
        on_demand
    }
    import common
}