{$DOMAIN:localhost} {
    reverse_proxy frontend:80

    # Security headers (Caddy adds some by default; keep consistent with nginx)
    header {
        X-Frame-Options "SAMEORIGIN"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
    }

    # Enable compression
    encode gzip
}
