# Flask Backend
SECRET_KEY=your-super-secret-key-change-in-production
FLASK_ENV=development

# Database (if using an OVHcloud Managed Database)
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Frontend (Vite)
VITE_API_URL=http://localhost:8080

# OVHcloud deployment (MKS + Managed Private Registry) — used by scripts/deploy.sh and CI
# OVH_REGISTRY_URL=https://xxxxx.c1.gra7.container-registry.ovh.net
# OVH_REGISTRY_USER=how-to-be-human-ci
# OVH_REGISTRY_PASSWORD=change-me
# HARBOR_PROJECT=how-to-be-human
# TAG=latest
# NAMESPACE=how-to-be-human
# KUBECONFIG=/path/to/mks-kubeconfig.yaml
