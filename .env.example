# VPS-2 deployment (single VM, Docker Compose + Caddy) — used by vps/deploy.sh
# DOMAIN=example.com
# VPS_HOST=51.68.12.34
# VPS_USER=deploy
# APP_DIR=/opt/how-to-be-human

# MediaWiki (production stack in docker-compose.prod.yml)
# MW_SITE_NAME=HowToBeHuman
# MW_DB_NAME=mediawiki
# MW_DB_USER=mediawiki
# MW_DB_PASSWORD=change-me-to-a-long-random-string
# (DB host inside the stack is always `db`; the web/CLI installer asks for it.)
